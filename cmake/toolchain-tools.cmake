MACRO(SELECT_TOOLCHAIN)
    IF (NOT DEFINED TOOLCHAIN_TARGET_TRIPLET)
        SET(TOOLCHAIN_TARGET_TRIPLET "")
        MESSAGE(STATUS "Using no special target triplet. System wide GCC in use")
    ELSE ()
        SET(TOOLCHAIN_TARGET_TRIPLET "${TOOLCHAIN_TARGET_TRIPLET}-")
    ENDIF ()

    IF (NOT DEFINED TOOLCHAIN_PREFIX)
        SET(TOOLCHAIN_PREFIX "/usr")
        MESSAGE(STATUS "No TOOLCHAIN_PREFIX specified, using default: " ${TOOLCHAIN_PREFIX})
    ELSE ()
        FILE(TO_CMAKE_PATH "${TOOLCHAIN_PREFIX}" TOOLCHAIN_PREFIX)
    ENDIF ()

    # Set toolchain parameters
    SET(TOOLCHAIN_BIN_DIR "${TOOLCHAIN_PREFIX}/bin")

    SET(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    SET(CMAKE_C_COMPILER "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}gcc${TOOLCHAIN_SUFFIX}${TOOL_EXECUTABLE_SUFFIX}")
    SET(CMAKE_CXX_COMPILER "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}g++${TOOLCHAIN_SUFFIX}${TOOL_EXECUTABLE_SUFFIX}")
    SET(CMAKE_ASM_COMPILER "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}gcc${TOOLCHAIN_SUFFIX}${TOOL_EXECUTABLE_SUFFIX}")

    SET(CMAKE_OBJCOPY "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}objcopy${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "objcopy tool")
    SET(CMAKE_OBJDUMP "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}objdump${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "objdump tool")
    SET(CMAKE_SIZE "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}size${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "size tool")
    SET(CMAKE_DEBUGER "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}gdb${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "debuger")
    SET(CMAKE_CPPFILT "${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}c++filt${TOOL_EXECUTABLE_SUFFIX}" CACHE INTERNAL "C++filt")
    SET(CMAKE_AR ${TOOLCHAIN_BIN_DIR}/${TOOLCHAIN_TARGET_TRIPLET}ar${TOOL_EXECUTABLE_SUFFIX} CACHE INTERNAL "Archive tool")
ENDMACRO()
